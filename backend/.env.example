# Environment Variables — EB Wireman Assistant Backend
# Copy this file to .env and fill in your values. NEVER commit .env to git.

PORT=5000

# MongoDB Atlas connection string (replace with your MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eb_houses?retryWrites=true&w=majority

# CORS origin whitelist
CORS_ORIGIN=*

# JWT Authentication Secret (generate a strong random secret)
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP for sending OTP (Free Gmail App Password)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to myaccount.google.com/apppasswords -> Create App Password for "Mail"
# 3. Paste your 16-character app password below
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_char_app_password
